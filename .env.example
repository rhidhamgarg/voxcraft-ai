# AI Voice Generation Provider Configuration
# Supported providers: 'elevenlabs', 'deepgram', 'cartesia', 'mock'
# If no provider API key is supplied, VoxCraft automatically uses the built-in high-fidelity audio synthesizer.
AI_VOICE_PROVIDER=mock
ELEVENLABS_API_KEY=
DEEPGRAM_API_KEY=
CARTESIA_API_KEY=

# Supabase (Optional for full persistent database & auth)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe Billing (Optional)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
